# Supabase Configuration (Cloud Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Intake Webhook Shared Secret (for Google Apps Script HMAC verification)
INTAKE_WEBHOOK_SECRET=

# Guest Registration Form (Public URL to the shared Google Form)
NEXT_PUBLIC_REGISTRATION_FORM_URL=

# Email Dispatch: Primary via Gmail SMTP (host smtp.gmail.com:465)
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional fallback email dispatch via Resend
RESEND_API_KEY=

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator & Booth Authentication (Server-only secrets)
# OPERATOR_PIN: 4-8 digit PIN used to access /admin/* and /booth/*
OPERATOR_PIN=
# SESSION_SECRET: 32+ character random secret for signing operator session cookies
SESSION_SECRET=
# SESSION_HOURS: Session duration in hours (optional, default 12)
SESSION_HOURS=12

# Hardware Gateway Mode: "mock" (default simulated hardware) or "webcam" (browser camera + 4x6 print)
NEXT_PUBLIC_HARDWARE_MODE=mock
