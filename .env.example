# Supabase Configuration (Cloud Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Intake Webhook Shared Secret (for Google Apps Script HMAC verification)
INTAKE_WEBHOOK_SECRET=

# Email Dispatch via Resend (optional: if omitted, email sending is skipped during intake)
RESEND_API_KEY=
EMAIL_FROM=

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Booth Screen Operator PIN (Mock value for dev/demo - NOT production security)
NEXT_PUBLIC_BOOTH_PIN=1234

# Hardware Gateway Mode: "mock" (default simulated hardware) or "webcam" (browser camera + 4x6 print)
NEXT_PUBLIC_HARDWARE_MODE=mock
